# Public build configuration. Leave blank to keep integrations honestly unavailable.
# Worldwide search/weather use real no-key Open-Meteo evaluation endpoints.
# Commercial release requires a paid account and a server-side key/proxy; see
# docs/worldwide-search-verification.md. Never bundle that secret as EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key fallback; never use a Supabase service-role or sb_secret key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Full public HTTPS backend URL, ending in /packing-chat.
# A Metro/Expo tunnel URL does not expose this separate Node server.
EXPO_PUBLIC_ASSISTANT_URL=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Replace development identifiers before signing a release.
WAYLO_IOS_BUNDLE_ID=dev.waylo.travel
WAYLO_ANDROID_PACKAGE=dev.waylo.travel
