# Reads and profile editing use the public key plus the verified administrator's session.
# Falls back to the root app's EXPO_PUBLIC_SUPABASE_* values when these are blank.
ADMIN_SUPABASE_URL=
ADMIN_SUPABASE_PUBLISHABLE_KEY=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8788
# Exact browser origin. Use this URL (not localhost) for the default local setup.
# Production must use HTTPS, with the reverse proxy preserving this Host header.
ADMIN_ORIGIN=http://127.0.0.1:8788
# Optional, SERVER ONLY: required only to create/send Supabase user invitations.
# Never copy this value into EXPO_PUBLIC_* or admin/public/.
ADMIN_SUPABASE_SECRET_KEY=
# Must match an exact approved redirect in the same Supabase project.
# Local web example: http://127.0.0.1:8081/auth/callback
ADMIN_INVITE_REDIRECT_URL=
# Development loopback only. Real administrator sign-in remains required.
# Run npm.cmd run admin:seed-demo first. Live and demo data never merge.
ADMIN_DEMO_DATA=0
