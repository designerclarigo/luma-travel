# Server only. Never copy OPENAI_API_KEY into the mobile app.
OPENAI_API_KEY=
OPENAI_MODEL=
SUPABASE_URL=
# Prefer the public publishable key. This server verifies the USER bearer token;
# it does not need a privileged Supabase service-role/secret key.
SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback; leave blank when using SUPABASE_PUBLISHABLE_KEY.
SUPABASE_ANON_KEY=
# Exact comma-separated web origins (including localhost ports for Expo web).
# Native Expo Go requests have no browser Origin; blank is fine for native-only.
ALLOWED_ORIGINS=
# Loopback is safe for local checks. Use 0.0.0.0 in a hosted container behind HTTPS.
HOST=127.0.0.1
PORT=8787
