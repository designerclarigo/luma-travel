# Used ONLY by npm run backend:verify-live; never bundled into Expo.
# Use four different, existing, email-confirmed disposable test accounts.
# The verification does NOT create accounts or send email.
WAYLO_TEST_OWNER_EMAIL=
WAYLO_TEST_OWNER_PASSWORD=
WAYLO_TEST_EDITOR_EMAIL=
WAYLO_TEST_EDITOR_PASSWORD=
WAYLO_TEST_VIEWER_EMAIL=
WAYLO_TEST_VIEWER_PASSWORD=
WAYLO_TEST_OUTSIDER_EMAIL=
WAYLO_TEST_OUTSIDER_PASSWORD=
# Set to 1 only to include one real, billable AI request against the HTTPS endpoint.
WAYLO_VERIFY_AI=0
